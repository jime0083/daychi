# Firebase Web SDK構成値
# Firebaseコンソール > プロジェクト設定 > マイアプリ(ウェブアプリ)で取得できる値を設定する
# (manual-work.txt Work 1 完了後に設定。Emulator利用のみなら未設定でも動作する)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# true にするとFirestore/Auth Emulator Suite(localhost)に接続する
# (Firestore: localhost:8080, Auth: localhost:9099。ポート設定はタスク1-3のfirebase.jsonと整合させる)
NEXT_PUBLIC_USE_EMULATOR=false

# YouTube Data API v3(タスク4-1〜。サーバー専用・NEXT_PUBLIC_を付けない。manual-work.txt Work5)
# APIキー(必須。Google Cloud ConsoleでYouTube Data API v3を有効化して発行する)
YOUTUBE_API_KEY=
# 取り込み対象チャンネルID(未設定時は既定でDaychi〜COFFEE CHANNELのID UCYSc0Xm18s8fp45JjApiOjA を使う)
YOUTUBE_CHANNEL_ID=

# AI自動抽出パイプライン(タスク4-3〜。サーバー専用・NEXT_PUBLIC_を付けない)
# 使用するAIプロバイダ("gemini" | "claude"。未設定時は既定で"gemini"を使う。
# "claude"を明示的に指定しない限りClaudeアダプタは呼ばれない。manual-work.txt W7/将来のClaude用Work)
AI_PROVIDER=
# Gemini APIキー(既定プロバイダ。Google AI StudioでAPIキーを発行する。manual-work.txt Work7)
GEMINI_API_KEY=
# Claude APIキー(実装のみ・実行は保留。AI_PROVIDER=claude を明示した場合のみ使用する)
CLAUDE_API_KEY=
